            {
                "box": {
                    "code": "@param({min:0}) offsetdays = 0;\r\n@param({min:0}) offsetseconds = 0;\r\n@param({min:0}) offsetsamples = 0;\r\n\r\nlet days = in1;\r\nlet seconds = in2;\r\nlet samples = in3;\r\nlet sr = samplerate();\r\n\r\nsamples += offsetsamples;\r\nif (samples >= sr) {\r\n    extra_seconds = floor(samples / sr);\r\n    samples -= extra_seconds * sr;\r\n    seconds += extra_seconds;\r\n}\r\n\r\nseconds += offsetseconds;\r\nif (seconds > 86400) {\r\n    extra_days = floor(seconds / 86400);\r\n    seconds -= extra_days * 86400;\r\n    days += extra_days;\r\n}\r\n\r\ndays += offsetdays;\r\n\r\nout3 = samples;\r\nout2 = seconds;\r\nout1 = days;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-25",
                    "maxclass": "codebox~",
                    "numinlets": 3,
                    "numoutlets": 3,
                    "outlettype": [ "signal", "signal", "signal" ],
                    "patching_rect": [ 234.0, 377.0, 340.0, 200.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "code": "@param({min:0}) offsetdays = 0;\r\n@param({min:0}) offsetseconds = 0;\r\n@param({min:0}) offsetsamples = 0;\r\n\r\nlet days = in1;\r\nlet seconds = in2;\r\nlet samples = in3;\r\nlet sr = samplerate();\r\n\r\nsamples += offsetsamples;\r\nif (samples >= sr) {\r\n    extra_seconds = floor(samples / sr);\r\n    samples -= extra_seconds * sr;\r\n    seconds += extra_seconds;\r\n}\r\n\r\nseconds += offsetseconds;\r\nif (seconds > 86400) {\r\n    extra_days = floor(seconds / 86400);\r\n    seconds -= extra_days * 86400;\r\n    days += extra_days;\r\n}\r\n\r\ndays += offsetdays;\r\n\r\nout3 = samples;\r\nout2 = seconds;\r\nout1 = days;",
                        "expr": "",
                        "safemath": 1
                    },
