            {
                "box": {
                    "code": "@param({min:0}) testdays = 0;\n@param({min:0}) testseconds = 0;\n@param({min:0}) testsamples = 0;\n\nlet days = in1;\nlet seconds = in2;\nlet samples = in3;\n\nlet val = 0;\n\nif (days == testdays) {\n    if (seconds == testseconds) {\n        if (samples < testsamples) {\n            val = -1;\n        } else if (samples > testsamples) {\n            val = 1;\n        }\n    } else if (seconds > testseconds) {\n        val = 1;\n    } else {\n        val = -1;\n    }\n} else if (days > testdays) {\n    val = 1;\n} else {\n    val = -1;\n}\n\nout1 = val;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-65",
                    "maxclass": "codebox~",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 63.0, 337.0, 475.0, 200.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "code": "@param({min:0}) testdays = 0;\n@param({min:0}) testseconds = 0;\n@param({min:0}) testsamples = 0;\n\nlet days = in1;\nlet seconds = in2;\nlet samples = in3;\n\nlet val = 0;\n\nif (days == testdays) {\n    if (seconds == testseconds) {\n        if (samples < testsamples) {\n            val = -1;\n        } else if (samples > testsamples) {\n            val = 1;\n        }\n    } else if (seconds > testseconds) {\n        val = 1;\n    } else {\n        val = -1;\n    }\n} else if (days > testdays) {\n    val = 1;\n} else {\n    val = -1;\n}\n\nout1 = val;",
                        "expr": "",
                        "safemath": 1
                    },
                    "rnbo_serial": 1,
                    "rnbo_uniqueid": "codebox~_obj-65",
