                    "text": "p loop_start",
                    "varname": "loop_start"
                }
            },
            {
                "box": {
                    "code": "// This scripts keeps track of the\r\n// looping state of a groove~ object.\r\n// Make sure to connect the right outlet\r\n// of the groove~ object. @synctype\r\n// should be set to relative, and \r\n// @syncmode should be set to ms or samples.\r\n// \r\n// Return value: \r\n// 2: Loop just started (one sample only)\r\n// 1: Playing\r\n// 0: Stopped\r\n// -1: Paused\r\n\r\n@state previous_sync_value = 0;\r\n@state status = 0;\r\n\r\nlet sync_value = in1;\r\nlet sync_delta = sync_value - previous_sync_value;\r\nprevious_sync_value = sync_value;\r\n\r\nif (sync_delta > 0) {\r\n    // Sync value is increasing, this means the\r\n    // loop is playing.\r\n    status = status == 0 ? 2 : 1;\r\n} else if (sync_delta < 0) {\r\n    // We just started playing a new loop.\r\n    status = 2;\r\n} else if (sync_value > 0) {\r\n    // We are paused.\r\n    status = -1;\r\n} else {\r\n    // We are either stopped or un-initialized.\r\n    status = 0;\r\n}\r\n\r\nout1 = status;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-110",
                    "maxclass": "codebox~",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 63.0, 203.0, 431.0, 194.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "code": "// This scripts keeps track of the\r\n// looping state of a groove~ object.\r\n// Make sure to connect the right outlet\r\n// of the groove~ object. @synctype\r\n// should be set to relative, and \r\n// @syncmode should be set to ms or samples.\r\n// \r\n// Return value: \r\n// 2: Loop just started (one sample only)\r\n// 1: Playing\r\n// 0: Stopped\r\n// -1: Paused\r\n\r\n@state previous_sync_value = 0;\r\n@state status = 0;\r\n\r\nlet sync_value = in1;\r\nlet sync_delta = sync_value - previous_sync_value;\r\nprevious_sync_value = sync_value;\r\n\r\nif (sync_delta > 0) {\r\n    // Sync value is increasing, this means the\r\n    // loop is playing.\r\n    status = status == 0 ? 2 : 1;\r\n} else if (sync_delta < 0) {\r\n    // We just started playing a new loop.\r\n    status = 2;\r\n} else if (sync_value > 0) {\r\n    // We are paused.\r\n    status = -1;\r\n} else {\r\n    // We are either stopped or un-initialized.\r\n    status = 0;\r\n}\r\n\r\nout1 = status;",
                        "expr": "",
                        "safemath": 1
                    },
                    "rnbo_serial": 4,
                    "rnbo_uniqueid": "codebox~_obj-110",
                    "rnboinfo": {
                        "needsInstanceInfo": 1,
