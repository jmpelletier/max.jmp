            {
                "box": {
                    "fontface": 1,
                    "fontsize": 16.0,
                    "id": "obj-96",
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 51.0, 96.0, 197.0, 26.0 ],
                    "text": "Time offset"
                }
            },
            {
                "box": {
                    "id": "obj-15",
                    "linecount": 13,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 552.0, 136.0, 156.0, 194.0 ],
                    "text": "Add an offset to a message timestamp. Note that this only accepts POSITIVE offsets. We can't go back in time.\n\nThe offset values don't need to be clamped: you can add a number of samples greater than the sample rate and the correct number of seconds will be added to the timestamp."
                }
            },
            {
                "box": {
                    "code": "let timestamp: list = listin1;\r\nlet offset: list = listin2;\r\n\r\nlet offsetdays = offset[0];\r\nlet offsetseconds = offset[1];\r\nlet offsetsamples = offset[2];\r\n\r\nlet days = timestamp[0];\r\nlet seconds = timestamp[1];\r\nlet samples = timestamp[2];\r\nlet sr = samplerate();\r\n\r\nsamples += offsetsamples;\r\nif (samples >= sr) {\r\n    extra_seconds = floor(samples / sr);\r\n    samples -= extra_seconds * sr;\r\n    seconds += extra_seconds;\r\n}\r\n\r\nseconds += offsetseconds;\r\nif (seconds > 86400) {\r\n    extra_days = floor(seconds / 86400);\r\n    seconds -= extra_days * 86400;\r\n    days += extra_days;\r\n}\r\n\r\ndays += offsetdays;\r\n\r\nlistout1 = [days, seconds, samples];",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-53",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 104.0, 231.0, 368.0, 230.0 ],
                    "rnbo_classname": "codebox",
                    "rnbo_extra_attributes": {
                        "hot": 0,
                        "nocache": 0,
                        "code": "let timestamp: list = listin1;\r\nlet offset: list = listin2;\r\n\r\nlet offsetdays = offset[0];\r\nlet offsetseconds = offset[1];\r\nlet offsetsamples = offset[2];\r\n\r\nlet days = timestamp[0];\r\nlet seconds = timestamp[1];\r\nlet samples = timestamp[2];\r\nlet sr = samplerate();\r\n\r\nsamples += offsetsamples;\r\nif (samples >= sr) {\r\n    extra_seconds = floor(samples / sr);\r\n    samples -= extra_seconds * sr;\r\n    seconds += extra_seconds;\r\n}\r\n\r\nseconds += offsetseconds;\r\nif (seconds > 86400) {\r\n    extra_days = floor(seconds / 86400);\r\n    seconds -= extra_days * 86400;\r\n    days += extra_days;\r\n}\r\n\r\ndays += offsetdays;\r\n\r\nlistout1 = [days, seconds, samples];",
                        "safemath": 1
                    },
                    "rnbo_serial": 1,
