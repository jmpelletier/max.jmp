        "default_fontname": "Lato",
        "title": "jmp.rnbo.clock",
        "boxes": [
            {
                "box": {
                    "id": "obj-7",
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 564.0, 439.0, 153.0, 21.0 ],
                    "text": "Samples"
                }
            },
            {
                "box": {
                    "id": "obj-6",
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 332.0, 439.0, 153.0, 21.0 ],
                    "text": "Seconds"
                }
            },
            {
                "box": {
                    "id": "obj-4",
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 100.0, 439.0, 153.0, 21.0 ],
                    "text": "Days"
                }
            },
            {
                "box": {
                    "angle": 270.0,
                    "bgcolor": [ 0.7411764705882353, 0.7411764705882353, 0.7411764705882353, 1.0 ],
                    "id": "obj-49",
                    "maxclass": "panel",
                    "mode": 0,
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 51.0, 100.0, 654.0, 4.0 ],
                    "proportion": 0.5,
                    "rounded": 0
                }
            },
            {
                "box": {
                    "fontface": 1,
                    "fontsize": 16.0,
                    "id": "obj-96",
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 50.0, 106.0, 197.0, 26.0 ],
                    "text": "Clock"
                }
            },
            {
                "box": {
                    "id": "obj-15",
                    "linecount": 13,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 551.0, 146.0, 153.0, 194.0 ],
                    "text": "The largest consecutive integer we can represent using float32 is 16777216.\n\nThis corresponds to about 380 seconds, a little over 6 minutes, worth of samples at 44100 Hz.\n\nWe can represent time as:\n- Day\n- Second\n- Sample"
                }
            },
            {
                "box": {
                    "code": "// This script maintains a global, sample-accurate\r\n// clock. Since 32-bit floats cannot represent sample\r\n// indices greater than 16,777,216, which is only about\r\n// 380 seconds at 44,100Hz, we split the timecode in\r\n// days, seconds and samples, giving us a sample-accurate\r\n// timer that can run for over 40,000 years.\r\n\r\n@state day = 0;\r\n@state second = 0;\r\n@state sample = 0;\r\n\r\nout1 = day;\r\nout2 = second;\r\nout3 = sample;\r\n\r\nsample++;\r\nif (sample >= samplerate()) {\r\n    sample = 0;\r\n    second++;\r\n    if (second >= 86400) { // Number of seconds in a day\r\n        second = 0;\r\n        day++; // We have enough days for 45,964 years!\r\n    }\r\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-5",
                    "maxclass": "codebox~",
                    "numinlets": 1,
                    "numoutlets": 3,
                    "outlettype": [ "signal", "signal", "signal" ],
                    "patching_rect": [ 50.0, 136.0, 484.0, 243.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "code": "// This script maintains a global, sample-accurate\r\n// clock. Since 32-bit floats cannot represent sample\r\n// indices greater than 16,777,216, which is only about\r\n// 380 seconds at 44,100Hz, we split the timecode in\r\n// days, seconds and samples, giving us a sample-accurate\r\n// timer that can run for over 40,000 years.\r\n\r\n@state day = 0;\r\n@state second = 0;\r\n@state sample = 0;\r\n\r\nout1 = day;\r\nout2 = second;\r\nout3 = sample;\r\n\r\nsample++;\r\nif (sample >= samplerate()) {\r\n    sample = 0;\r\n    second++;\r\n    if (second >= 86400) { // Number of seconds in a day\r\n        second = 0;\r\n        day++; // We have enough days for 45,964 years!\r\n    }\r\n}",
                        "expr": "",
                        "safemath": 1
                    },
                    "rnbo_serial": 1,
